// Skia font rendering is not consistent across platforms
//ignore:skia

// SIZE=64x64
// ROTATION_THRESHOLD=45  - the border radius algorithm doesn't give the same result from every rotation

// Text inside a rounded clip is cut at the curve (LISTARY PATCH in the software renderer): the
// glyphs overflow the clip on every side, and outside the curves the black background shows.

export component TestCase inherits Window {
    width: 64px;
    height: 64px;
    background: black;

    Rectangle {
        x: 4px;
        y: 4px;
        width: 56px;
        height: 56px;
        clip: true;
        border-radius: 20px;
        background: #303030;
        Text {
            x: -6px;
            y: -10px;
            text: "MW\nWM";
            font-size: 40px;
            color: #ffd000;
        }
    }
}
